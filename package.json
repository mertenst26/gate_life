{
  "name": "gate-life",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*", "server", "client"],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @gate-life/server",
    "dev:client": "npm run dev -w @gate-life/client",
    "build": "npm run build -w @gate-life/shared && npm run build -w @gate-life/server && npm run build -w @gate-life/client"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
